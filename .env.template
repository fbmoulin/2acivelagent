# Sistema de Automacao Juridica - Environment Variables Template
# Copy this file to .env and fill in the values
# NEVER commit .env file to version control!

# ===========================================
# N8N Configuration
# ===========================================
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_USER=admin
N8N_PASSWORD=change_me_secure_password
WEBHOOK_URL=http://localhost:5678/

# ===========================================
# Database Configuration
# ===========================================
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=n8n
POSTGRES_USER=n8n_user
POSTGRES_PASSWORD=change_me_postgres_password

# ===========================================
# Redis Configuration
# ===========================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change_me_redis_password
REDIS_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/0

# ===========================================
# OpenAI Configuration
# ===========================================
OPENAI_API_KEY=sk-your_openai_api_key_here
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=2000

# ===========================================
# DATAJUD API (CNJ)
# ===========================================
DATAJUD_USERNAME=your_datajud_username
DATAJUD_PASSWORD=your_datajud_password
DATAJUD_BASE_URL=https://api-publica.datajud.cnj.jus.br

# ===========================================
# Google Cloud Configuration
# ===========================================
# Option 1: Path to service account JSON file
GOOGLE_APPLICATION_CREDENTIALS=/opt/credentials/google-service-account.json

# Option 2: Inline JSON (for Docker)
# GOOGLE_APPLICATION_CREDENTIALS_JSON={"type": "service_account", ...}

# Google Document AI
GOOGLE_PROJECT_ID=your_project_id
GOOGLE_LOCATION=us
GOOGLE_PROCESSOR_ID=your_processor_id

# ===========================================
# Email Configuration (SMTP)
# ===========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=noreply@yourdomain.com
SMTP_FROM_NAME=Sistema Automacao Juridica

# ===========================================
# Monitoring (Grafana)
# ===========================================
GRAFANA_USER=admin
GRAFANA_PASSWORD=change_me_grafana_password
GF_SERVER_ROOT_URL=http://localhost:3000/

# ===========================================
# Security
# ===========================================
# REQUIRED: Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=generate_a_secure_64_character_hex_key_here
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24

# API Authentication (set to true in production)
API_AUTH_ENABLED=true

# CORS - Comma-separated list of allowed origins
ALLOWED_ORIGINS=https://your-domain.com,https://n8n.your-domain.com

# Encryption key for sensitive data
ENCRYPTION_KEY=generate_another_32_character_key

# ===========================================
# Application Settings
# ===========================================
FLASK_ENV=production
FLASK_DEBUG=false
LOG_LEVEL=INFO
TIMEZONE=America/Sao_Paulo

# ===========================================
# LGPD Compliance
# ===========================================
# Data retention in hours (168 = 7 days)
EXECUTIONS_DATA_MAX_AGE=168
EXECUTIONS_DATA_PRUNE=true

# ===========================================
# Optional: Sentry Error Tracking
# ===========================================
# SENTRY_DSN=https://your_sentry_dsn_here

# ===========================================
# Optional: AWS S3 for Backups
# ===========================================
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# AWS_REGION=sa-east-1
# S3_BACKUP_BUCKET=your-backup-bucket-name
